PORT=3000
APP_URL=http://localhost:3000

# Pinterest Developer App
PINTEREST_CLIENT_ID=1601884
PINTEREST_CLIENT_SECRET=YOUR_APP_SECRET
PINTEREST_REDIRECT_URI=http://localhost:3000/auth/pinterest/callback

# Scopes needed for board discovery + publishing
PINTEREST_SCOPES=boards:read,boards:write,pins:read,pins:write,user_accounts:read
